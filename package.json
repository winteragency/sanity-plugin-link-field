{
  "name": "sanity-plugin-link-field",
  "version": "1.6.0",
  "description": "A custom Link field for Sanity Studio",
  "keywords": [
    "sanity",
    "sanity-plugin",
    "links",
    "portable-text"
  ],
  "homepage": "https://github.com/winteragency/sanity-plugin-link-field#readme",
  "bugs": {
    "url": "https://github.com/winteragency/sanity-plugin-link-field/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/winteragency/sanity-plugin-link-field.git"
  },
  "license": "MIT",
  "author": "Winter Agency <info@winteragency.se>",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./helpers": {
      "source": "./src/helpers.ts",
      "import": "./dist/helpers.js",
      "default": "./dist/helpers.js"
    },
    "./component": {
      "source": "./src/component.ts",
      "import": "./dist/component.js",
      "default": "./dist/component.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "plugin-kit verify-package --silent && pkg-utils build --strict --check --clean",
    "format": "prettier --write --cache --ignore-unknown .",
    "link-watch": "plugin-kit link-watch",
    "lint": "eslint .",
    "prepublishOnly": "npm run build",
    "prepare": "lefthook install",
    "watch": "pkg-utils watch --strict",
    "check:types": "tsc --pretty --noEmit",
    "check:format": "prettier --check .",
    "fix:format": "prettier --write .",
    "fix:lint": "eslint src/ --fix --quiet",
    "test": "vitest run",
    "test:example": "npm run build && cd example && npm install && npm test"
  },
  "dependencies": {
    "@sanity/icons": "^3",
    "lucide-react": "^1.22.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.1.0",
    "@commitlint/config-conventional": "^21.1.0",
    "@eslint/js": "^9.39.4",
    "@sanity/pkg-utils": "^10.7.2",
    "@sanity/plugin-kit": "^6.0.0",
    "@sanity/ui": "^3",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^10.0.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "@vitejs/plugin-react": "^5.1.4",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^28.1.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "lefthook": "^2.1.9",
    "prettier": "^3.9.2",
    "prettier-plugin-packagejson": "^3.0.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sanity": "^6.2.0",
    "semantic-release": "^25.0.5",
    "semantic-release-license": "^1.0.3",
    "styled-components": "^6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.62.0",
    "vitest": "^4.1.9"
  },
  "peerDependencies": {
    "@sanity/ui": "^3",
    "react": "^18 || ^19",
    "sanity": "^3 || ^4 || ^5 || ^6",
    "styled-components": "^5.2 || ^6"
  },
  "engines": {
    "node": ">=22.12",
    "npm": ">=11.17.0"
  },
  "packageManager": "npm@11.17.0",
  "lint-staged": {
    "*.js": "eslint --cache --fix"
  },
  "sanityPlugin": {
    "verifyPackage": {
      "eslintImports": false,
      "nodeEngine": false
    }
  },
  "browserslist": "extends @sanity/browserslist-config",
  "publishConfig": {
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./helpers": {
        "import": "./dist/helpers.js",
        "default": "./dist/helpers.js"
      },
      "./component": {
        "import": "./dist/component.js",
        "default": "./dist/component.js"
      },
      "./package.json": "./package.json"
    }
  }
}
